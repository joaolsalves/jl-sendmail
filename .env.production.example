# ==========================================================
# VARIÁVEIS DE AMBIENTE — PRODUÇÃO (Hostinger)
# ==========================================================
# Copie este arquivo para .env.production e preencha os valores.
# NUNCA versione o arquivo .env.production.
# ==========================================================

# Banco de dados MySQL da Hostinger
# Formato: mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO
# Use %23 para codificar o caractere # na senha
DATABASE_URL="mysql://u436946109_db_sendmail:%2BQ3a%21B%7Cs8@localhost:3306/u436946109_db_sendmail"

# SMTP Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@jldatainfo.com
SMTP_PASS=sua-senha-smtp
SMTP_FROM=no-reply@jldatainfo.com

# Chave administrativa — mantenha a mesma do ambiente local ou gere uma nova
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# CORS — apenas o domínio de produção
ALLOWED_ORIGINS=https://sendmail.jldatainfo.com

# Porta — a Hostinger geralmente usa 3000 ou define automaticamente
PORT=3000
