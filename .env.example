# ============================================================
# AMBIENTE LOCAL (desenvolvimento)
# ============================================================
# DATABASE_URL="mysql://root:senha@localhost:3306/db_sendmail"
# ALLOWED_ORIGINS=http://localhost:3000
# PORT=3000

# ============================================================
# AMBIENTE PRODUÇÃO (Hostinger — sendmail.jldatainfo.com)
# ============================================================
# DATABASE_URL="mysql://user:senha@localhost:3306/db_sendmail"
# ALLOWED_ORIGINS=https://sendmail.jldatainfo.com
# PORT=3000

# ============================================================
# VARIÁVEIS COMPARTILHADAS (preencher em ambos os ambientes)
# ============================================================

# Database — use %23 para codificar # na senha
DATABASE_URL="mysql://user:password@localhost:3306/db_sendmail"

# SMTP Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@jldatainfo.com
SMTP_PASS=
SMTP_FROM=no-reply@jldatainfo.com

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# CORS — origens permitidas separadas por vírgula
# Local:      http://localhost:3000
# Produção:   https://sendmail.jldatainfo.com
ALLOWED_ORIGINS=http://localhost:3000

# Porta do servidor (padrão: 3000)
PORT=3000
