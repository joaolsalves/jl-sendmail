# Database
# Use %23 to encode # in passwords
DATABASE_URL="mysql://user:password@localhost:3306/database"

# SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@seudominio.com.br
SMTP_PASS=
SMTP_FROM=no-reply@seudominio.com.br

# Auth — generate a strong random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://seudominio.com.br,https://app.seudominio.com.br

# Server
PORT=3000
